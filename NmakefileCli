# Build helperCli only from the repository root:
# nmake /f NmakefileCli clean release

!if !defined(CXX)
CXX = cl.exe
!endif
!if !defined(LINK)
LINK = link.exe
!endif

.NOTPARALLEL:

LLAMA_BASE = .\llama.cpp
LLAMA_INC_PATH = $(LLAMA_BASE)\llama.cpp-master\include
GGML_INC_PATH = $(LLAMA_BASE)\llama.cpp-master\ggml\include
COMMON_INC_PATH = $(LLAMA_BASE)\llama.cpp-master\common
HTTPLIB_INC_PATH = $(LLAMA_BASE)\llama.cpp-master\vendor
LLAMA_BIN_PATH = $(LLAMA_BASE)\release-shared_x64_ms
LLAMA_LIB_PATH = $(LLAMA_BASE)\msbuild\src
GGML_BASE_LIB_PATH = $(LLAMA_BASE)\msbuild\ggml\src
COMMON_LIB_PATH = $(LLAMA_BASE)\msbuild\common
SERVER_LIB_PATH = $(LLAMA_BASE)\msbuild\tools\server
HTTPLIB_LIB_PATH = $(LLAMA_BASE)\msbuild\vendor\cpp-httplib

!if !defined(CUDA_BIN_PATH)
CUDA_BIN_PATH = C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.1\bin
!endif

CXXFLAGS = /nologo /EHsc /std:c++17 /MD /O2 /DNDEBUG /MP /D_MPTRACE_ /DUNICODE /D_UNICODE /DMP_UNICODE /D_CRT_SECURE_NO_WARNINGS /DLLAMA_SHARED /DGGML_SHARED /I"helperCli\include" /I"include" /I"$(LLAMA_INC_PATH)" /I"$(GGML_INC_PATH)" /I"$(COMMON_INC_PATH)" /I"$(HTTPLIB_INC_PATH)"
LDFLAGS = /nologo /SUBSYSTEM:CONSOLE /MACHINE:X64 /LIBPATH:"$(LLAMA_LIB_PATH)" /LIBPATH:"$(GGML_BASE_LIB_PATH)" /LIBPATH:"$(COMMON_LIB_PATH)" /LIBPATH:"$(SERVER_LIB_PATH)" /LIBPATH:"$(HTTPLIB_LIB_PATH)"
LIBS = llama.lib ggml.lib ggml-base.lib ggml-cpu.lib llama-common.lib llama-common-base.lib llama-server-impl.lib cpp-httplib.lib ws2_32.lib winmm.lib advapi32.lib ole32.lib

SRC_DIR = helperCli\source
INC_DIR = helperCli\include
OBJ_DIR = helperCli\obj\cli-only\release
BIN_DIR = helperCli\bin\release
TARGET = $(BIN_DIR)\helperCli.exe
PCH_FILE = $(OBJ_DIR)\pre.pch
OBJ_FILES = $(OBJ_DIR)\pre.obj $(OBJ_DIR)\cli.obj $(OBJ_DIR)\cli-client.obj $(OBJ_DIR)\cli-context.obj $(OBJ_DIR)\RunHandler.obj $(OBJ_DIR)\main.obj
HEADERS = $(INC_DIR)\cli-client.hxx $(INC_DIR)\cli-context.hxx $(INC_DIR)\cli-server.hxx $(INC_DIR)\cli-ui.hxx $(INC_DIR)\cli-todo.hxx $(INC_DIR)\RunHandler.hxx

.PHONY: all release clean

all: release

release: $(TARGET)
	@copy /Y "$(LLAMA_BIN_PATH)\llama.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\ggml.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\ggml-base.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\ggml-cpu.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\llama-common.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\llama-server-impl.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\mtmd.dll" "$(BIN_DIR)\"
	@if exist "$(LLAMA_BIN_PATH)\ggml-cuda.dll" copy /Y "$(LLAMA_BIN_PATH)\ggml-cuda.dll" "$(BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cudart64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cudart64_12.dll" "$(BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cublas64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cublas64_12.dll" "$(BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cublasLt64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cublasLt64_12.dll" "$(BIN_DIR)\"

$(TARGET): $(OBJ_FILES)
	@if not exist "$(BIN_DIR)" mkdir "$(BIN_DIR)"
	$(LINK) $(LDFLAGS) /OUT:"$@" $(OBJ_FILES) $(LIBS)

$(OBJ_DIR)\pre.obj $(PCH_FILE): $(INC_DIR)\pre.hxx include\str.hxx include\trace.hxx $(SRC_DIR)\pre.cxx
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	$(CXX) $(CXXFLAGS) /Yc"pre.hxx" /Fp"$(PCH_FILE)" /c /Fo"$(OBJ_DIR)\pre.obj" $(SRC_DIR)\pre.cxx

$(OBJ_DIR)\cli.obj $(OBJ_DIR)\cli-client.obj $(OBJ_DIR)\cli-context.obj $(OBJ_DIR)\RunHandler.obj $(OBJ_DIR)\main.obj: $(PCH_FILE) $(HEADERS)

{$(SRC_DIR)}.cxx{$(OBJ_DIR)}.obj:
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	$(CXX) $(CXXFLAGS) /Yu"pre.hxx" /Fp"$(PCH_FILE)" /c /Fo"$@" $<

clean:
	@if exist "$(TARGET)" del /Q "$(TARGET)"
	@for %%F in ($(OBJ_FILES) $(PCH_FILE)) do @if exist "%%F" del /Q "%%F"
