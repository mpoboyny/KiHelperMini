# VS2019 NMakefile for helperCli
#
# Build:  nmake /f NMakefile release
# Test:   nmake /f NMakefile test
# Clean:  nmake /f NMakefile clean
#
# Run from inside the helperCli directory. The MSVC environment
# (vcvarsall.bat x64) must be loaded so cl.exe and link.exe are on PATH.

!if !defined(CXX)
CXX = cl.exe
!endif
!if !defined(LINK)
LINK = link.exe
!endif

# The PCH rule produces pre.obj as a side effect of cl /Yc, which nmake does
# not track; keep the build serial to avoid interleaving that side effect.
.NOTPARALLEL:

LLAMA_BASE        = ../llama.cpp
LLAMA_INC_PATH    = $(LLAMA_BASE)\llama.cpp-master\include
GGML_INC_PATH     = $(LLAMA_BASE)\llama.cpp-master\ggml\include
COMMON_INC_PATH   = $(LLAMA_BASE)\llama.cpp-master\common
HTTPLIB_INC_PATH  = $(LLAMA_BASE)\llama.cpp-master\vendor
KIHELPER_INC_PATH = ../include

LLAMA_BIN_PATH   = $(LLAMA_BASE)\release-shared_x64_ms
LLAMA_LIB_PATH   = $(LLAMA_BASE)\msbuild\src
GGML_BASE_LIB_PATH = $(LLAMA_BASE)\msbuild\ggml\src
COMMON_LIB_PATH  = $(LLAMA_BASE)\msbuild\common
SERVER_LIB_PATH  = $(LLAMA_BASE)\msbuild\tools\server
HTTPLIB_LIB_PATH = $(LLAMA_BASE)\msbuild\vendor\cpp-httplib

GTEST_BASE       = ../googletest
GTEST_INC_PATH   = $(GTEST_BASE)\googletest\include
GTEST_LIB_PATH   = $(GTEST_BASE)\release-shared_x64\lib

!if !defined(CUDA_BIN_PATH)
CUDA_BIN_PATH = C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.1\bin
!endif

CXXFLAGS = /nologo /EHsc /std:c++17 /MD /O2 /DNDEBUG /MP /D_MPTRACE_ /DUNICODE /D_UNICODE /DMP_UNICODE /D_CRT_SECURE_NO_WARNINGS /DLLAMA_SHARED /DGGML_SHARED /I"include" /I"$(LLAMA_INC_PATH)" /I"$(GGML_INC_PATH)" /I"$(COMMON_INC_PATH)" /I"$(HTTPLIB_INC_PATH)" /I"$(KIHELPER_INC_PATH)"

LDFLAGS = /nologo /SUBSYSTEM:CONSOLE /MACHINE:X64 /LIBPATH:$(LLAMA_LIB_PATH) /LIBPATH:$(GGML_BASE_LIB_PATH) /LIBPATH:$(COMMON_LIB_PATH) /LIBPATH:$(SERVER_LIB_PATH) /LIBPATH:$(HTTPLIB_LIB_PATH)

LLAMA_LIBS   = llama.lib ggml.lib ggml-base.lib ggml-cpu.lib
COMMON_LIBS  = llama-common.lib llama-common-base.lib
SERVER_LIBS  = llama-server-impl.lib
HTTPLIB_LIBS = cpp-httplib.lib
SYS_LIBS     = ws2_32.lib winmm.lib advapi32.lib ole32.lib

OBJ_DIR_ROOT  = obj
BIN_DIR_ROOT  = bin
BUILD_TYPE    = release

OBJ_DIR = $(OBJ_DIR_ROOT)\$(BUILD_TYPE)
BIN_DIR = $(BIN_DIR_ROOT)\$(BUILD_TYPE)

SOURCES = source\pre.cxx source\cli.cxx source\cli-client.cxx source\cli-context.cxx source\RunHandler.cxx source\main.cxx
OBJ_FILES = $(OBJ_DIR)\pre.obj $(OBJ_DIR)\cli.obj $(OBJ_DIR)\cli-client.obj $(OBJ_DIR)\cli-context.obj $(OBJ_DIR)\RunHandler.obj $(OBJ_DIR)\main.obj
HEADERS = include\cli-client.hxx include\cli-context.hxx include\cli-server.hxx include\cli-ui.hxx include\RunHandler.hxx

TARGET = $(BIN_DIR)\helperCli.exe

PCH_FILE = $(OBJ_DIR)\pre.pch
# Token passed to /Yc//Yu; must match the `#include "pre.hxx"` directive in
# the sources. PCH_SRC is the real file used as a build dependency.
PCH_HDR  = pre.hxx
PCH_SRC  = include\pre.hxx

TEST_BIN_DIR  = $(BIN_DIR_ROOT)\tests\$(BUILD_TYPE)
TEST_OBJ_DIR  = $(OBJ_DIR_ROOT)\tests\$(BUILD_TYPE)
TEST_TARGET   = $(TEST_BIN_DIR)\helperCli-tests.exe
TEST_SOURCES  = tests\common.cxx tests\createAndEditFile.cxx
TEST_OBJ_FILES = $(TEST_OBJ_DIR)\common.obj $(TEST_OBJ_DIR)\createAndEditFile.obj

.PHONY: all release test clean

all: release

release: $(TARGET)

test: release $(TEST_TARGET)
	$(TEST_TARGET)

$(TARGET): $(OBJ_FILES) scripts\helperCliRunner.bat
	@if not exist $(BIN_DIR) mkdir $(BIN_DIR)
	@echo Linking $@...
	$(LINK) $(LDFLAGS) /OUT:$@ $(OBJ_FILES) $(LLAMA_LIBS) $(COMMON_LIBS) $(SERVER_LIBS) $(HTTPLIB_LIBS) $(SYS_LIBS)
	@echo Copying required DLLs...
	@copy /Y "$(LLAMA_BIN_PATH)\llama.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\ggml.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\ggml-base.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\ggml-cpu.dll" "$(BIN_DIR)\"
	@if exist "$(LLAMA_BIN_PATH)\ggml-cuda.dll" copy /Y "$(LLAMA_BIN_PATH)\ggml-cuda.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\llama-common.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\llama-server-impl.dll" "$(BIN_DIR)\"
	@copy /Y "$(LLAMA_BIN_PATH)\mtmd.dll" "$(BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cudart64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cudart64_12.dll" "$(BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cublas64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cublas64_12.dll" "$(BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cublasLt64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cublasLt64_12.dll" "$(BIN_DIR)\"
	@echo Copying runner script...
	@copy /Y "scripts\helperCliRunner.bat" "$(BIN_DIR)\"

# Create the precompiled header. cl /Yc also emits the object for pre.cxx,
# so this rule produces both. That object must be linked: it carries the
# symbols originating from the PCH (e.g. the frameMP helpers).
$(OBJ_DIR)\pre.obj $(PCH_FILE): $(PCH_SRC) $(KIHELPER_INC_PATH)\str.hxx $(KIHELPER_INC_PATH)\trace.hxx source\pre.cxx
	@if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	@$(CXX) $(CXXFLAGS) /Yc"$(PCH_HDR)" /Fp"$(PCH_FILE)" /c /Fo"$(OBJ_DIR)\pre.obj" source\pre.cxx

# The other objects depend on the PCH so a PCH change forces a full
# recompile. The actual compilation is done by the inference rule below.
$(OBJ_DIR)\cli.obj $(OBJ_DIR)\cli-client.obj $(OBJ_DIR)\cli-context.obj $(OBJ_DIR)\RunHandler.obj $(OBJ_DIR)\main.obj: $(PCH_FILE) $(HEADERS)

# Inference rule for all sources in source\ using the PCH.
{source}.cxx{$(OBJ_DIR)}.obj:
	@if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	@$(CXX) $(CXXFLAGS) /Yu"$(PCH_HDR)" /Fp"$(PCH_FILE)" /c /Fo"$@" $<

$(TEST_TARGET): $(TEST_OBJ_FILES)
	@if not exist $(TEST_BIN_DIR) mkdir $(TEST_BIN_DIR)
	@echo Linking $@...
	$(LINK) /nologo /SUBSYSTEM:CONSOLE /MACHINE:X64 /LIBPATH:$(GTEST_LIB_PATH) /OUT:$@ $(TEST_OBJ_FILES) gtest.lib
	@echo Copying required DLLs...
	@copy /Y "$(GTEST_LIB_PATH)\gtest.dll" "$(TEST_BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cudart64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cudart64_12.dll" "$(TEST_BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cublas64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cublas64_12.dll" "$(TEST_BIN_DIR)\"
	@if exist "$(CUDA_BIN_PATH)\cublasLt64_12.dll" copy /Y "$(CUDA_BIN_PATH)\cublasLt64_12.dll" "$(TEST_BIN_DIR)\"

# Rebuild the tests when their shared header changes.
$(TEST_OBJ_FILES): tests\common.hxx

# Inference rule for the test sources. The GTest include path is added here.
{tests}.cxx{$(TEST_OBJ_DIR)}.obj:
	@if not exist $(TEST_OBJ_DIR) mkdir $(TEST_OBJ_DIR)
	@$(CXX) $(CXXFLAGS) /I"$(GTEST_INC_PATH)" /c /Fo"$@" $<

clean:
	@if exist obj rmdir /S /Q obj
	@if exist bin rmdir /S /Q bin
	@if exist *.obj del /Q *.obj
	@if exist helperCli.exe del /Q helperCli.exe
	@if exist *.ilk del /Q *.ilk
	@if exist *.pdb del /Q *.pdb
