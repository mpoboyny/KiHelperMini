{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,

  "enabled_providers": ["kihelperminimini"],
  "experimental": {
    "policies": [
      { "effect": "deny",  "action": "provider.use", "resource": "*" },
      { "effect": "allow", "action": "provider.use", "resource": "kihelpermini" }
    ]
  },

  "model": "kihelpermini/<!-- model -->",
  "provider": {
    "kihelpermini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "kihelpermini buildin (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "sk-424242"
      },
      "models": {
        "<!-- model -->": {
          "name": "<!-- model --> (Local)",
          "tool_call": true, 
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },

  "permission": {
    "bash": "ask", 
    "edit": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask"
  }
}
