# VS2019 NMakefile for KiHelperMini

CXX = cl.exe
LINK = link.exe

WX_LIBDIR_PATH = ./wxWidgets/3.3.1/build-win-release-x64u/lib/vc_x64_dll
WX_INCLUDE = /I"./wxWidgets/3.3.1/include" /I"$(WX_LIBDIR_PATH)/mswu"
WX_LIBDIR = $(WX_LIBDIR_PATH)

CXXFLAGS = /nologo /EHsc /std:c++17 /MD /O2 /DNDEBUG /D__WXMSW__ /DWXUSINGDLL /DwxNO_EXCEPTIONS /DUNICODE /D_UNICODE /DMP_UNICODE /D_MPTRACE_ /D_CRT_SECURE_NO_WARNINGS $(WX_INCLUDE) /I"./include"

LDFLAGS = /nologo /SUBSYSTEM:WINDOWS /MACHINE:X64 /LIBPATH:$(WX_LIBDIR)

WX_LIBS = \
    wxmsw33u_core.lib \
    wxbase33u.lib \
	wxbase33u_net.lib \
    wxbase33u_xml.lib \
    wxmsw33u_stc.lib \
    wxpng.lib \
    wxzlib.lib \
    wxtiff.lib \
    wxjpeg.lib \
    wxexpat.lib

SYS_LIBS = user32.lib gdi32.lib comdlg32.lib shell32.lib ole32.lib oleaut32.lib advapi32.lib rpcrt4.lib

OBJ_DIR_ROOT = obj
BIN_DIR_ROOT = bin
BUILD_TYPE = release

BIN_DIR = $(BIN_DIR_ROOT)\$(BUILD_TYPE)
OBJ_DIR = $(OBJ_DIR_ROOT)\$(BUILD_TYPE)

SRC_DIR = source
INC_DIR = include
RES_DIR = resources

SRC_FILES = $(SRC_DIR)\*.cxx

# Leave HDRS empty here so nested nmake can be invoked with HDRS set at runtime.
HDRS =

PCH_FILE = $(OBJ_DIR)\prc.pch

TARGET = $(BIN_DIR)\KiHelperMini.exe

$(TARGET): $(SRC_FILES) $(PCH_FILE) $(OBJ_DIR)\resource.res $(HDRS)
	@if not exist $(BIN_DIR) mkdir $(BIN_DIR)
	@if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	@echo Building precompiled header...
	@nmake -nologo -f NMakefile $(OBJ_DIR)\prc.obj
	@echo Building sources (incremental)...
	@setlocal EnableDelayedExpansion & set "HDRS=" & for /f "delims=" %%H in ('dir /b /a-d $(INC_DIR)\*.hxx') do @(if "!HDRS!"=="" (set "HDRS=$(INC_DIR)\%%H") else (set "HDRS=!HDRS! $(INC_DIR)\%%H")) & for /f "delims=" %%F in ('dir /b /a-d $(SRC_DIR)\*.cxx') do @(if /I not "%%~nxF"=="prc.cxx" (nmake -nologo -f NMakefile HDRS="!HDRS!" $(OBJ_DIR)\%%~nF.obj)) & endlocal
	@echo Linking $@...
	$(LINK) $(LDFLAGS) /OUT:$@ $(OBJ_DIR)\*.obj $(OBJ_DIR)\*.res $(WX_LIBS) $(SYS_LIBS)
	@echo Copying required wxWidgets DLLs...
	@copy /Y "./wxWidgets/3.3.1/build-win-release-x64u/lib/vc_x64_dll\*.dll" "$(BIN_DIR)\"
	@copy /Y "config.xml" "$(BIN_DIR)\"
	@if not exist "$(BIN_DIR)\scripts" mkdir "$(BIN_DIR)\scripts"
	@copy /Y "scripts\*" "$(BIN_DIR)\scripts\"

release: $(TARGET)

runr: release
	@echo Running $(TARGET)...
	@$(TARGET)

# Rule for precompiled header creation
$(OBJ_DIR)\prc.obj $(PCH_FILE): $(SRC_DIR)\prc.cxx $(INC_DIR)\prc.hxx
	@if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	@$(CXX) $(CXXFLAGS) /Yc"prc.hxx" /Fp"$(PCH_FILE)" /c /Fo"$(OBJ_DIR)\prc.obj" $(SRC_DIR)\prc.cxx

# Inference rule for source files in source directory
{$(SRC_DIR)}.cxx{$(OBJ_DIR)}.obj:
	@if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	@$(CXX) $(CXXFLAGS) /Yu"prc.hxx" /Fp"$(PCH_FILE)" /c /Fo$@ $<

# Resource compilation (Clean and quiet production rule)
$(OBJ_DIR)\resource.res: $(RES_DIR)\resource.rc
	@if not exist $(OBJ_DIR) mkdir $(OBJ_DIR)
	@rc /nologo $(WX_INCLUDE) /i $(RES_DIR) /fo$@ $(RES_DIR)\resource.rc

clean:
	@if exist obj rmdir /S /Q obj
	@if exist bin rmdir /S /Q bin
	@if exist *.obj del /Q *.obj
	@if exist KiHelperMini.exe del /Q KiHelperMini.exe
	@if exist *.ilk del /Q *.ilk
	@if exist *.pdb del /Q *.pdb
